rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /inv_bancas/{id} { allow read, write: if true; }
    match /inv_lan/{id}    { allow read, write: if true; }
    match /inv_fin/{id}    { allow read, write: if true; }
    match /inv_hist/{id}   { allow read, write: if true; }

    // NOVAS: Doação atual, Etiquetas e preferências compartilhadas
    match /sh_doacao/{id}    { allow read, write: if true; }
    match /sh_etiquetas/{id} { allow read, write: if true; }
    match /sh_cfg/{id}       { allow read, write: if true; }

    // Acessos (presença/contagem)
    match /acessos/{id} {
      allow read, create: if true;
    }

    // Fotos dos produtos (uma miniatura por nome de produto)
    match /fotos/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['n','d','t'])
        && request.resource.data.n is string
        && request.resource.data.n.size() > 0 && request.resource.data.n.size() <= 120
        && request.resource.data.d is string && request.resource.data.d.size() <= 150000
        && request.resource.data.t is number;
    }

    // ACESSO ABERTO (sem login). As regras só validam o formato dos dados.
    match /products/{id} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['barcode','name','category','expiry','quantity','por','codigo_balanca','codigo_doacao','foto','lixo','retirado','retEm','retPor','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.category in ['Ovos','FLV','Padaria','Laticínios','Mercearia','Bebidas','Congelados','Higiene e limpeza','Outros','Perecíveis']
        && request.resource.data.expiry is string
        && (request.resource.data.expiry == '' || request.resource.data.expiry.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0 && request.resource.data.quantity < 100000
        && request.resource.data.barcode is string && request.resource.data.barcode.size() <= 32
        && (!('por' in request.resource.data) || (request.resource.data.por is string && request.resource.data.por.size() <= 40))
        && (!('codigo_balanca' in request.resource.data) || (request.resource.data.codigo_balanca is string && request.resource.data.codigo_balanca.size() <= 12))
        && (!('codigo_doacao' in request.resource.data) || (request.resource.data.codigo_doacao is string && request.resource.data.codigo_doacao.size() <= 12))
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 150000))
        && (!('lixo' in request.resource.data) || request.resource.data.lixo is number)
        && (!('retirado' in request.resource.data) || request.resource.data.retirado is bool)
        && (!('retEm' in request.resource.data) || request.resource.data.retEm is number)
        && (!('retPor' in request.resource.data) || (request.resource.data.retPor is string && request.resource.data.retPor.size() <= 40));
    }

    // Aparelhos que acessaram o app (presença)
    match /devices/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['nome','firstSeen','lastSeen','visitas','ua'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
        && request.resource.data.visitas is number;
      allow delete: if false;
    }

    // Histórico de leituras: só cria, nunca altera nem apaga
    match /scans/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['barcode','nome','por','cadastrado','em'])
        && request.resource.data.barcode is string && request.resource.data.barcode.size() <= 32
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.por is string && request.resource.data.por.size() <= 40
        && request.resource.data.cadastrado is bool;
      allow update, delete: if false;
    }

    // Romaneios de doação: criar, editar e excluir
    match /doacoes/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['data','codigo','por','itens','totalKg','totalUn','em','editada'])
        && request.resource.data.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.por is string && request.resource.data.por.size() <= 40
        && request.resource.data.itens is list && request.resource.data.itens.size() <= 300
        && (!('codigo' in request.resource.data) || (request.resource.data.codigo is string && request.resource.data.codigo.size() <= 12))
        && request.resource.data.totalKg is number && request.resource.data.totalUn is number;
    }
  }
}